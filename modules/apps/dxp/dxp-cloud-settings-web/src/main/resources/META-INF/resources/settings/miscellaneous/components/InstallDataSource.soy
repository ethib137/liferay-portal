{namespace InstallDataSource}

/**
 * @param? typesMap_
 * @param? onAddDataSource_
 * @param? onCancel_
 * @param? dataSources_
 * @param? onTypeSelect_
 * @param? tab_
 * @param? type_
 * @param? types_
 */
{template .render}
	<div class="wrapper">
		<div class="btn-wrapper">
			<a class="btn btn-default {if $tab_ == 'installDataSource'}btn-primary{/if}" href="javascript:;" onClick="installDataSourceClick_">Install Data Source</a>
			<a class="btn btn-default {if $tab_ == 'profile'}btn-primary{/if}" href="javascript:;" onClick="viewProfileClick_">View Profile</a>
		</div>

		<br />

		{if $tab_ == 'installDataSource'}
			<div key="installDataSource" class="install-data-source">
				<div class="container container-fluid container-lg">
					<div class="row">
						<div class="choose-data-source col-lg-16">
							{call EvanSelect.render}
								{param items: $types_ /}
								{param label: 'Install DS' /}
								{param open_: false /}
								{param onSelect: $onTypeSelect_ /}
							{/call}
						</div>
					</div>

					{if $type_ < 0 and $dataSources_ and $typesMap_}
						<h1>Current Data Sources:</h1>

						{call DSList.render}
							{param items: $dataSources_ /}
							{param typesMap: $typesMap_ /}
						{/call}
					{else}
						{if $onCancel_ and $onAddDataSource_ and isNonnull($type_) and $typesMap_}
							{call DSForm.render}
								{param onCancel: $onCancel_ /}
								{param onSuccess: $onAddDataSource_ /}
								{param type: $type_ /}
								{param typesMap: $typesMap_ /}
							{/call}
						{/if}
					{/if}
				</div>
			</div>
		{else}
			<div key="profile" class="profile-component">
				{call Profile.render /}
			</div>
		{/if}
	</div>
{/template}
